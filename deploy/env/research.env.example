# research.env.example — Research sidecar environment variables (Phase 6: IC gate harness)
# Copy to research.env and fill in actual values; real .env is gitignored
# Only loaded when running with --profile research

# PostgreSQL connection (reads metric_value, writes promotion_ledger)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=neyialiyorlar
POSTGRES_USER=neyi
POSTGRES_PASSWORD=neyi_dev_password

# Redis connection (optional: for streaming IC updates)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# IC gate behavior
IC_GATE_LOG_LEVEL=info
IC_GATE_DRY_RUN=false           # set true to preview decisions without writing to ledger

# Anti-data-snooping: path to config with pre-registered thresholds
CONFIG_PATH=/app/config/neyialiyorlar.yaml

# Performance tuning (research sidecar, no latency SLA)
QUERY_BATCH_SIZE=1000           # rows per DB fetch during join
CORRELATION_CHUNK_SIZE=500      # observations per rolling IC window (stride = 1)

# Time zone for event date interpretation
TIMEZONE=Europe/Istanbul
