# fund-scraper.env.example — copy to fund-scraper.env and fill in
DATABASE_URL=postgresql://neyi:dev_password@postgres:5432/neyialiyorlar

# ── AI PDF fallback parser (optional, local Ollama) ──────────────────────────
# When the deterministic regex parser can't read a fund's portfolio-PDF layout,
# the scraper asks a LOCAL Ollama model to extract the holdings (validated
# against the known BIST universe). It self-disables when Ollama is unreachable,
# so these are optional. The `ollama` compose service (same `fund-scraper`
# profile) provides it — bring both up together:
#   docker compose --profile fund-scraper up -d
#   docker exec ollama ollama pull llama3.1   # one-time model download (~4.7GB)
# Defaults below match docker-compose.yml; override only for a custom setup.
# AI_PARSER_ENABLED=1
# OLLAMA_HOST=http://ollama:11434
# OLLAMA_MODEL=llama3.1
