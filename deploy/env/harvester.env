# harvester.env.example — Harvester service environment variables
# Copy to harvester.env and fill in actual values; real .env is gitignored

# PostgreSQL connection (password required)
PGPASSWORD=dev_password

# Redis connection
REDIS_ADDR=redis:6379

# Service logging
LOG_LEVEL=info

# External API keys
EVDS_API_KEY=your_evds_key_here

# HTTP client settings
HTTP_TIMEOUT_MS=15000
MAX_CONCURRENT_PER_HOST=2
