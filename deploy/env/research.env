# research.env — Research sidecar environment variables
# Only loaded when running with --profile research

# PostgreSQL connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=neyialiyorlar
POSTGRES_USER=neyi
POSTGRES_PASSWORD=dev_password

# Redis connection
REDIS_HOST=redis
REDIS_PORT=6379

# Service logging
LOG_LEVEL=info

# Research mode
RESEARCH_MODE=development
